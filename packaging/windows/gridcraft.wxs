<?xml version="1.0" encoding="utf-8"?>
<!--
  Dexterity Sheets MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build gridcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Dexterity Sheets is the internal spreadsheet of Dexterity Design Services Pvt. Ltd., based on
  GridCraft (MIT OR Apache-2.0). It is a separate product from stock GridCraft: its own
  UpgradeCode, component GUID, install folder, registry keys and ProgIds, so both can be
  installed side by side.

  Per-user install into %LOCALAPPDATA%\Programs (no administrator rights needed, so the app
  can install its own updates from the office server), a Start Menu shortcut, an optional
  desktop shortcut,
  App Paths (Win+R `DexteritySheets`),
  and Dexterity Sheets offered under "Open with" (and in Settings > Default apps) for .xlsx,
  .xlsm, .csv and .tsv, without taking over the user's default app for them.

  UpgradeCode is fixed for Dexterity Sheets (generated 2026-10-26): never change it, or upgrades
  install side by side instead of replacing the old version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="Dexterity Sheets"
      Manufacturer="Dexterity Design Services Pvt. Ltd."
      Version="$(var.Version)"
      UpgradeCode="FE2AD491-38E3-4E1B-8441-FDF652AB8443"
      Scope="perUser"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Dexterity Sheets spreadsheet" Manufacturer="Dexterity Design Services Pvt. Ltd." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Dexterity Sheets is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="GridcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GridcraftIcon.ico" />
    <!-- No ARPURLINFOABOUT / ARPURLUPDATEINFO / ARPHELPLINK: an internal LAN tool links to no website. -->

    <!-- An explicit command-line value wins. Otherwise retain the previous installation's
         choice, defaulting to off for a fresh install. Run only in the first sequence so the
         execute sequence cannot reload the old choice after the user unchecks the box. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="SAVEDDESKTOPSHORTCUT" Secure="yes">
      <RegistrySearch Id="FindDesktopShortcutPreference" Root="HKCU"
          Key="Software\Dexterity Sheets\Installer" Name="DesktopShortcut" Type="raw" />
    </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Action="LoadDesktopShortcutPreference" Value="1"
        After="AppSearch" Sequence="first"
        Condition="NOT DESKTOPSHORTCUT AND SAVEDDESKTOPSHORTCUT = &quot;1&quot;" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="DefaultDesktopShortcut" Value="0"
        After="LoadDesktopShortcutPreference" Sequence="first" Condition="NOT DESKTOPSHORTCUT" />
    <SetProperty Id="DesktopShortcutChoice" Value="1" After="DefaultDesktopShortcut"
        Sequence="ui" Condition="DESKTOPSHORTCUT = &quot;1&quot;" />

    <Property Id="DefaultUIFont" Value="GridcraftUIFont" />
    <Property Id="ErrorDialog" Value="GridcraftErrorDlg" />
    <EnsureTable Id="ListBox" />
    <UI>
      <TextStyle Id="GridcraftUIFont" FaceName="Segoe UI" Size="9" />
      <Dialog Id="DesktopShortcutDlg" Width="320" Height="150" Title="Dexterity Sheets Setup" NoMinimize="yes">
        <Control Id="Heading" Type="Text" X="15" Y="15" Width="290" Height="20" Text="Install Dexterity Sheets" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="290" Height="28"
            Text="Install Dexterity Sheets for your Windows account. No administrator rights are needed." />
        <Control Id="DesktopShortcutCheckbox" Type="CheckBox" X="15" Y="76" Width="290" Height="18"
            Property="DesktopShortcutChoice" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
        <Control Id="Install" Type="PushButton" X="165" Y="118" Width="65" Height="20"
            Default="yes" Text="&amp;Install">
          <!-- An unchecked checkbox clears its property. Publish an explicit zero so the
               elevated execute sequence receives an unambiguous opt-out. -->
          <Publish Property="DESKTOPSHORTCUT" Value="1" Condition="DesktopShortcutChoice" />
          <Publish Property="DESKTOPSHORTCUT" Value="0" Condition="NOT DesktopShortcutChoice" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="118" Width="65" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Windows Installer requires these support dialogs for authored full UI (ICE20).
           They contain only installer messages and standard response controls. -->
      <Dialog Id="GridcraftErrorDlg" Width="320" Height="120" Title="Dexterity Sheets Setup" ErrorDialog="yes" NoMinimize="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="290" Height="65" TabSkip="no" />
        <Control Id="A" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Abort" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Cancel" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Ignore" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="No" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="OK" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Retry" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="Y" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Yes" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="320" Height="190" Title="Dexterity Sheets Setup" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="15" Y="15" Width="290" Height="35"
            Text="Close the applications listed below, then choose Retry. Ignore may require a restart." />
        <Control Id="Files" Type="ListBox" X="15" Y="55" Width="290" Height="85" Property="FileInUseProcess" />
        <Control Id="Retry" Type="PushButton" X="95" Y="155" Width="65" Height="20" Default="yes" Text="Retry">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="167" Y="155" Width="65" Height="20" Text="Ignore">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="155" Width="65" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCompleteDlg" Width="320" Height="110" Title="Dexterity Sheets Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Dexterity Sheets setup completed." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCanceledDlg" Width="320" Height="110" Title="Dexterity Sheets Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Dexterity Sheets setup was canceled." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupFailedDlg" Width="320" Height="110" Title="Dexterity Sheets Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Dexterity Sheets setup could not finish. See the installer message or log for details." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <!-- Component conditions must see the choice before costing. Do not show the choice
           during basic/silent installs, repair or uninstall. -->
      <Show Dialog="DesktopShortcutDlg" Before="CostInitialize" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </AdminUISequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Dexterity Sheets" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Dexterity Sheets" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="GridcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <!-- Per-user files need an HKCU key path (ICE38), so the notices are listed explicitly. -->
      <Component Id="Notices">
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Installer" Name="Notices" Value="1" Type="integer" KeyPath="yes" />
        <File Id="NoticeFile" Source="$(var.DocsDir)\NOTICE" />
        <File Id="AttributionFile" Source="$(var.DocsDir)\ATTRIBUTION.md" />
      </Component>
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="GridcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="GridcraftApp" Guid="C6E4E136-AEC6-4FFB-B929-E9F5711DF251">
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Installer" Name="App" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <File Id="GridcraftExe" Source="$(var.BinDir)\DexteritySheets.exe">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Dexterity Sheets"
              Description="Dexterity Sheets spreadsheet" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="GridcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\DexteritySheets.exe" Value="[#GridcraftExe]" Type="string" />

        <!-- ProgIds: how Explorer opens a file with Dexterity Sheets. Nothing here sets HKCR\.<ext>'s
             default value, so the user's current default app is left alone. -->
        <RegistryValue Root="HKCU" Key="Software\Classes\DexteritySheets.Workbook" Value="Dexterity Sheets Workbook" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\DexteritySheets.Workbook\DefaultIcon" Value="&quot;[#GridcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\DexteritySheets.Workbook\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\DexteritySheets.TextData" Value="Dexterity Sheets Text Data" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\DexteritySheets.TextData\DefaultIcon" Value="&quot;[#GridcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\DexteritySheets.TextData\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with": Windows reads only the value names under OpenWithProgids; the data is
             ignored (WiX rejects an empty Value, so it repeats the ProgId). -->
        <RegistryValue Root="HKCU" Key="Software\Classes\.xlsx\OpenWithProgids" Name="DexteritySheets.Workbook" Value="DexteritySheets.Workbook" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.xlsm\OpenWithProgids" Name="DexteritySheets.Workbook" Value="DexteritySheets.Workbook" Type="string" />
        <!-- .xlsb and .ods are imported (data only) into a new workbook that saves as .xlsx. -->
        <RegistryValue Root="HKCU" Key="Software\Classes\.xlsb\OpenWithProgids" Name="DexteritySheets.Workbook" Value="DexteritySheets.Workbook" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.ods\OpenWithProgids" Name="DexteritySheets.Workbook" Value="DexteritySheets.Workbook" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.csv\OpenWithProgids" Name="DexteritySheets.TextData" Value="DexteritySheets.TextData" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.tsv\OpenWithProgids" Name="DexteritySheets.TextData" Value="DexteritySheets.TextData" Type="string" />

        <!-- Settings > Default apps: lets the user pick Dexterity Sheets for these types. -->
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Capabilities" Name="ApplicationName" Value="Dexterity Sheets" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Capabilities" Name="ApplicationDescription" Value="Dexterity Design Services spreadsheet for .xlsx, CSV and TSV files" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Capabilities\FileAssociations" Name=".xlsx" Value="DexteritySheets.Workbook" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Capabilities\FileAssociations" Name=".xlsm" Value="DexteritySheets.Workbook" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Capabilities\FileAssociations" Name=".csv" Value="DexteritySheets.TextData" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Capabilities\FileAssociations" Name=".tsv" Value="DexteritySheets.TextData" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="Dexterity Sheets" Value="Software\Dexterity Sheets\Capabilities" Type="string" />
      </Component>

      <Component Id="GridcraftCli">
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Installer" Name="Cli" Value="1" Type="integer" KeyPath="yes" />
        <File Id="GridcraftCliExe" Source="$(var.BinDir)\gridcraft-cli.exe" />
      </Component>

      <!-- Persist both on and off, independently of the optional shortcut. AppSearch reads
           this before MajorUpgrade removes the previous product. -->
      <Component Id="DesktopShortcutPreference">
        <RegistryValue Root="HKCU" Key="Software\Dexterity Sheets\Installer" Name="DesktopShortcut"
            Value="[DESKTOPSHORTCUT]" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Dexterity Sheets" Description="Dexterity Sheets spreadsheet"
            Target="[#GridcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="GridcraftIcon.ico" IconIndex="0" />
        <!-- HKMU resolves to HKCU for this per-user package. MSI root -1 also satisfies ICE43. -->
        <RegistryValue Root="HKMU" Key="Software\Dexterity Sheets\Installer" Name="DesktopShortcutComponent"
            Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
